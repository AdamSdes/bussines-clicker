{
  "name": "empire-from-zero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "«Империя с нуля» — браузерный бизнес-кликер на реальной истории рынков",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "data:fetch": "node scripts/fetch-history.mjs",
    "data:build": "node scripts/build-history.mjs",
    "data": "npm run data:fetch && npm run data:build",
    "sim": "tsx scripts/balance-sim.ts"
  },
  "dependencies": {
    "canvas-confetti": "1.9.4",
    "framer-motion": "11.18.2",
    "lightweight-charts": "4.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
