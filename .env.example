# Ключи для «Живого режима» (когда игровое время догоняет реальную дату).
# Все ключи необязательны: без них игра продолжает рынок симуляцией.

# CoinGecko Demo API (бесплатный ключ: https://www.coingecko.com/en/api/pricing)
# Demo-план: ~30–100 запросов/мин, 10 000 кредитов/мес — игра опрашивает раз в 5 минут.
VITE_COINGECKO_API_KEY=

# Finnhub (бесплатный ключ: https://finnhub.io/register) — 60 запросов/мин.
# Котировки акций/ETF + лента реальных новостей в живом режиме.
VITE_FINNHUB_API_KEY=

# Интервалы опроса в секундах (не ставьте меньше, чтобы не упереться в лимиты бесплатных тарифов)
VITE_LIVE_CRYPTO_POLL_SEC=300
VITE_LIVE_STOCKS_POLL_SEC=120
